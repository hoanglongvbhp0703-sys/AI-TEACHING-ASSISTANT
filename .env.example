# Chạy python scripts/init_local.py để sinh .env với token ngẫu nhiên.
# Không commit .env hoặc token thật. Bản này chỉ hỗ trợ local/development/test.
APP_ENV=local
DATABASE_URL=sqlite:///./data/gos.db
UPLOAD_DIR=./data/uploads
STAGING_DIR=./data/staging
MOCK_UI_ENABLED=true
SEED_DEMO_ON_START=false
# run_rag.py bật RAG và callback; run_portal.py đọc trạng thái RAG trong .env.
RAG_JOBS_ENABLED=true
# JSON map token >=24 ký tự -> user_id. init_local.py tự sinh các token demo.
AUTH_TOKENS_JSON={}
MOCK_WEBHOOK_SECRET=
MOCK_WEBHOOK_AUTH_MODE=hmac
# Dùng connection khi kiểm tra giả lập -> webhook -> callback; business cho luồng nghiệp vụ.
MOCK_WEBHOOK_MODE=business
MOCK_BACKEND_URL=http://127.0.0.1:8001
MOCK_CALLBACK_URL=http://127.0.0.1:9000/api/mock/replies
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=65536
BACKGROUND_JOBS_ENABLED=true
JOB_POLL_SECONDS=1
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=5
MEMORY_MAX_TURNS=5
MEMORY_TTL_MINUTES=30
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=11534336
SQLITE_BUSY_TIMEOUT_MS=5000
# Quota cố định 30 câu/ngày/người, trên tất cả lớp.

# RAG thật: scripts/run_rag.py bật rõ RAG + business callback.
RAG_ENABLED=false
RAG_VECTOR_DIR=./data/qdrant
RAG_MODEL_CACHE=./data/models
RAG_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RAG_ALLOWED_EMBEDDING_MODELS=["bkai-foundation-models/vietnamese-bi-encoder"]
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_DEVICE=cpu
RAG_CPU_THREADS=4
RAG_LLM_TIMEOUT_SECONDS=45
RAG_MAX_OUTPUT_TOKENS=1200
CLAUDE_BASE_URL=https://hhtechapi.net
CLAUDE_MODEL=claude-sonnet-4.6
# Điền riêng trong .env; cũng hỗ trợ env_api_ai_claude hiện có.
CLAUDE_API_KEY=
MOCK_OUTBOUND_HTTP_ENABLED=false
SIMULATOR_BUSINESS_MODE=false


# Contextual rewriting: mặc định dùng CLAUDE_MODEL; gọi trước embedding khi có history.
RAG_REWRITE_ENABLED=true
# RAG_REWRITE_MODEL=claude-sonnet-4.6
RAG_REWRITE_TIMEOUT_SECONDS=20
RAG_REWRITE_MAX_TOKENS=512
